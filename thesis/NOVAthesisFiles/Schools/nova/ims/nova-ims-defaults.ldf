\newcommand{\ims@selectcovers}{%
  % Só faz isto para MSc
  \IfStrEq{\@DOCTYPE}{msc}{%
    % Capa
    \thesiscover(msc,1-1,image):={%
      \theimsfront(\imsDegree,\imsSpecialization,\@LANG@COVER)%
    }%
    % Contracapa
    \thesiscover(msc,N-2,image):={%
      \theimsback(\imsDegree,\imsSpecialization,\@LANG@COVER)%
    }%
  }{}%
}

\AtEndPreamble{\ims@selectcovers}



